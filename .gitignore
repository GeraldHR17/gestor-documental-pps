# Dependencias de Node.js
node_modules/

# Variables de entorno
.env
.env.*
!.env.example

# Excepciones: estos dos SI se versionan porque no contienen secretos.
#  - frontend/.env.production solo lleva rutas publicas relativas, y Vite
#    las necesita en el build; todo lo que empieza por VITE_ viaja en el
#    bundle, asi que por definicion no puede ser secreto.
#  - despliegue/.env.produccion.ejemplo es una plantilla con valores
#    ficticios; el archivo real vive en la carpeta de configuracion de la
#    VM, fuera del repositorio.
!frontend/.env.production
!despliegue/.env.produccion.ejemplo

# Logs
*.log
logs/

# Archivos generados
dist/
build/
coverage/

# Archivos temporales
tmp/
temp/

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Archivos de Visual Studio Code
.vscode/

# Archivos de Docker
docker-data/

# Documentos PDF de desarrollo
*.pdf

# Archivos de respaldo de bases de datos
*.sql.gz
*.zip

# Archivos temporales
*.tmp
*.bak

# Base de datos
base-datos/respaldos/*
!base-datos/respaldos/.gitkeep