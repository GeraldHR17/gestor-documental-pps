# ============================================================
# Frontend (Vite) — variables públicas
# ============================================================
# Sólo se exponen al navegador las que empiezan por VITE_. Copie este
# archivo como `.env.local` y ajuste los valores; nunca ponga aquí
# credenciales: todo lo que lleve el prefijo VITE_ viaja en el bundle.

# API del backend. Si se omite, se usa http://localhost:3000.
VITE_API_URL=http://localhost:3000

# Portal público de transparencia (WordPress), sistema externo todavía no
# desplegado. Mientras esta variable esté vacía, el botón "Abrir portal
# público" de la pantalla de Inicio permanece oculto: no se enlaza a una
# dirección que aún no existe.
VITE_URL_PORTAL_PUBLICO=
