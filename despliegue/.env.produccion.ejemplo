# ============================================================
# Muni Data — variables de entorno de PRODUCCION (plantilla)
# ============================================================
# Este archivo es una PLANTILLA con valores ficticios. El archivo real
# vive en:
#
#     C:\munidata\config\.env.produccion
#
# es decir fuera del repositorio y fuera de htdocs, para que ni un
# despliegue ni una mala configuracion de Apache puedan servirlo por HTTP.
#
# desplegar.ps1 lo copia desde aqui la primera vez, genera solo los
# secretos JWT y se detiene para que usted complete BD_* y SMTP_*. Luego
# lee este archivo y escribe su contenido en AppEnvironmentExtra del
# servicio MuniData-API.
#
# REGLAS:
#  - Sin comillas alrededor de los valores: en un archivo .env las
#    comillas viajan como parte del valor.
#  - Sin espacios alrededor del "=".
#  - Una variable por linea. Las lineas que empiezan por "#" se ignoran.
#  - Ningun valor CAMBIEME debe quedar sin reemplazar: desplegar.ps1 se
#    detiene si encuentra alguno.

# ------------------------------------------------------------
# Entorno y red
# ------------------------------------------------------------

# Activa el comportamiento de produccion en todo el backend: TypeORM deja
# de registrar consultas, la cookie del refresh token se emite con
# secure=true y el correo nunca cae en la cuenta de pruebas de Ethereal.
# Debe valer exactamente "production".
NODE_ENV=production

# Puerto local del backend. Solo lo usa Apache: no se abre en el firewall.
# Debe coincidir con el ProxyPass de despliegue/apache/munidata.conf.
PUERTO=3100

# Interfaz de escucha. 127.0.0.1 deja el puerto accesible unicamente desde
# la propia VM, de modo que el unico camino hacia la API es el proxy de
# Apache. No la cambie a 0.0.0.0.
HOST_ESCUCHA=127.0.0.1

# Hace que Express confie en X-Forwarded-For y X-Forwarded-Proto del
# primer proxy. Es necesaria porque detras de Apache la conexion que ve
# Node viene de 127.0.0.1 y en claro, asi que sin esto la limitacion de
# tasa por IP agruparia a todos los usuarios como si fueran uno.
CONFIAR_EN_PROXY=true

# URL publica del frontend, CON la subruta y SIN barra final. Se usa para
# dos cosas: construir los enlaces que van dentro de los correos
# (restablecer contrasena, verificar correo) y derivar el origen permitido
# por CORS. Si queda apuntando a localhost, los enlaces de los correos no
# funcionaran para nadie.
FRONTEND_URL=https://CAMBIEME.ejemplo.go.cr/munipalmares/wp-munidata

# ------------------------------------------------------------
# Base de datos
# ------------------------------------------------------------
# El usuario NO debe ser root: preparar-base-datos.ps1 crea un usuario
# dedicado con privilegios unicamente sobre esta base (minimo privilegio,
# ISO/IEC 27001 A.9.2).

BD_HOST=127.0.0.1
BD_PUERTO=3306
BD_NOMBRE=munidata
BD_USUARIO=munidata_app
BD_CONTRASENA=CAMBIEME_contrasena_del_usuario_de_aplicacion

# ------------------------------------------------------------
# Secretos de firma de tokens
# ------------------------------------------------------------
# desplegar.ps1 los genera solos (64 bytes aleatorios en base64) la
# primera vez. NO los reutilice de desarrollo y no los comparta: con
# cualquiera de los dos se pueden falsificar sesiones.
#
# Cambiarlos invalida de inmediato todas las sesiones activas, que es
# justo lo que se quiere si se sospecha una filtracion.

JWT_ACCESS_SECRET=CAMBIEME_lo_genera_desplegar_ps1
JWT_REFRESH_SECRET=CAMBIEME_lo_genera_desplegar_ps1

# Vida del access token y del refresh token. La sesion tiene ademas una
# expiracion absoluta de 8 horas que no depende de estos valores.
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=2h

# ------------------------------------------------------------
# Politicas de autenticacion
# ------------------------------------------------------------

# Rondas de bcrypt. No la baje: 12 es el valor con el que se generaron los
# hash existentes y el que usa el script de creacion del administrador.
BCRYPT_SALT_ROUNDS=12

# Bloqueo por intentos fallidos de inicio de sesion.
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Vigencia de los enlaces que se envian por correo.
TOKEN_RECUPERACION_EXPIRACION_MIN=60
TOKEN_VERIFICACION_EXPIRACION_HORAS=24

# ------------------------------------------------------------
# Almacenamiento de documentos
# ------------------------------------------------------------
# Carpeta donde se guardan los PDF, con nombre UUID. Esta FUERA de htdocs
# a proposito: no debe existir ninguna forma de descargar un documento sin
# pasar por la API, que verifica permisos y registra la descarga en la
# bitacora.
#
# Se admite ruta absoluta de Windows. Si cambia este valor con documentos
# ya cargados, mueva primero la carpeta: la base guarda rutas relativas a
# esta raiz.
RUTA_ALMACENAMIENTO=C:\munidata\storage\documentos

# ------------------------------------------------------------
# Retencion de la bitacora
# ------------------------------------------------------------
# Meses que se conservan en bitacora_logs. La purga corre el dia 1 de cada
# mes a las 03:00 y el borrado es FISICO, sin respaldo previo. Si la
# institucion necesita conservar el historico mas alla de esta ventana,
# exporte el tramo antes de purgarlo. Poner 0 deshabilita la purga.
BITACORA_RETENCION_MESES=3

# ------------------------------------------------------------
# Correo saliente (SMTP)
# ------------------------------------------------------------
# Verificado contra smtp.gmail.com:587 con STARTTLS. El puerto 587 exige
# secure=false, que el backend ya deriva del numero de puerto.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CAMBIEME@gmail.com

# ATENCION: la contrasena de aplicacion de Google se muestra en cuatro
# grupos de cuatro letras ("xxxx xxxx xxxx xxxx"). Escribala aqui SIN
# ESPACIOS, en una sola palabra de 16 letras minusculas. El backend
# tambien quita los espacios por si acaso, pero en produccion conviene que
# el archivo quede limpio.
#
# Debe ser una contrasena de aplicacion, no la contrasena de la cuenta:
# con la contrasena normal Gmail responde 534-5.7.9 y no envia nada. Se
# genera en https://myaccount.google.com/apppasswords
SMTP_PASS=CAMBIEME_contrasena_de_aplicacion_16_letras

# Remitente. Debe coincidir con SMTP_USER: Gmail reescribe el remitente a
# la cuenta autenticada salvo que la direccion este registrada como alias
# verificado.
SMTP_FROM=CAMBIEME@gmail.com
