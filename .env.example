# Configuración de la aplicación
NOMBRE_APLICACION=Gestor Documental PPS
ENTORNO=desarrollo

# Backend
PUERTO=3000

# Frontend
PUERTO_FRONTEND=5173
FRONTEND_URL=http://localhost:5173

# ============================================================
# Base de datos — contenedor MySQL (docker-compose.yml)
# ============================================================
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=gestor_documental_pps
MYSQL_USER=gestor_app
MYSQL_PASSWORD=changeme
MYSQL_PORT=3306

# ============================================================
# Base de datos — conexión de NestJS (configuracion/base-datos.configuracion.ts)
# ============================================================
BD_HOST=localhost
BD_PUERTO=3306
BD_NOMBRE=gestor_documental_pps
BD_USUARIO=gestor_app
BD_CONTRASENA=changeme

# ============================================================
# Autenticación (Fase 4)
# ============================================================
# Los dos secretos DEBEN ser distintos entre sí y generarse al azar.
# Para generar uno nuevo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CAMBIAR_EN_ENTORNO_LOCAL
JWT_REFRESH_SECRET=CAMBIAR_EN_ENTORNO_LOCAL_Y_DISTINTO_DEL_ANTERIOR
JWT_ACCESS_EXPIRATION=15m
# Expiración ABSOLUTA de la sesión (una jornada laboral): a las 8 horas del
# login se exige volver a autenticar, con o sin actividad. La renovación
# del token no reinicia este plazo.
JWT_REFRESH_EXPIRATION=8h

# Costo de bcrypt para el hash de contraseñas.
BCRYPT_SALT_ROUNDS=12

# Bloqueo temporal por intentos fallidos (RF-12).
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Vigencia de los tokens de un solo uso enviados por correo.
TOKEN_RECUPERACION_EXPIRACION_MIN=60
TOKEN_VERIFICACION_EXPIRACION_HORAS=24

# ============================================================
# Correo saliente (SMTP) — verificación de cuenta y recuperación
# ============================================================
# Si SMTP_HOST queda vacío fuera de producción, CorreoService crea solo
# una cuenta de pruebas de Ethereal (https://ethereal.email): los correos
# NO llegan a buzones reales, pero cada envío deja en el log del backend
# una URL de vista previa para abrir el mensaje tal como se enviaría. Con
# SMTP_HOST definido se usa ese servidor con las credenciales de abajo
# (rellenarlas a mano; nunca se asumen valores). SMTP_FROM es el remitente
# de pruebas acordado con el PO y se cambia aquí, sin tocar código.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alcaldia@munipalmares.go.cr
