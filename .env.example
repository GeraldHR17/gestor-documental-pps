# Configuración de la aplicación
NOMBRE_APLICACION=Gestor Documental PPS
ENTORNO=desarrollo

# Backend
PUERTO=3000

# Frontend
PUERTO_FRONTEND=5173
FRONTEND_URL=http://localhost:5173

# ============================================================
# Base de datos — contenedor MySQL (docker-compose.yml)
# ============================================================
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=gestor_documental_pps
MYSQL_USER=gestor_app
MYSQL_PASSWORD=changeme
MYSQL_PORT=3306

# ============================================================
# Base de datos — conexión de NestJS (configuracion/base-datos.configuracion.ts)
# ============================================================
BD_HOST=localhost
BD_PUERTO=3306
BD_NOMBRE=gestor_documental_pps
BD_USUARIO=gestor_app
BD_CONTRASENA=changeme

# ============================================================
# Autenticación (Fase 4)
# ============================================================
# Los dos secretos DEBEN ser distintos entre sí y generarse al azar.
# Para generar uno nuevo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CAMBIAR_EN_ENTORNO_LOCAL
JWT_REFRESH_SECRET=CAMBIAR_EN_ENTORNO_LOCAL_Y_DISTINTO_DEL_ANTERIOR
JWT_ACCESS_EXPIRATION=15m
# Expiración ABSOLUTA de la sesión (una jornada laboral): a las 8 horas del
# login se exige volver a autenticar, con o sin actividad. La renovación
# del token no reinicia este plazo.
JWT_REFRESH_EXPIRATION=8h

# Costo de bcrypt para el hash de contraseñas.
BCRYPT_SALT_ROUNDS=12

# Bloqueo temporal por intentos fallidos (RF-12).
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Vigencia de los tokens de un solo uso enviados por correo.
TOKEN_RECUPERACION_EXPIRACION_MIN=60
TOKEN_VERIFICACION_EXPIRACION_HORAS=24

# ============================================================
# Correo saliente (SMTP) — verificación de cuenta y recuperación
# ============================================================
# Si SMTP_HOST queda vacío fuera de producción, CorreoService crea solo
# una cuenta de pruebas de Ethereal (https://ethereal.email): los correos
# NO llegan a buzones reales, pero cada envío deja en el log del backend
# una URL de vista previa para abrir el mensaje tal como se enviaría. Con
# SMTP_HOST definido se usa ese servidor con las credenciales de abajo
# (rellenarlas a mano; nunca se asumen valores). SMTP_FROM es el remitente
# de pruebas acordado con el PO y se cambia aquí, sin tocar código.
#
# Para comprobar que las credenciales sirven, desde backend/:
#   npm run correo:verificar                         (solo autentica)
#   npm run correo:verificar -- --enviar tu@correo.com  (envía una prueba)
# Hace falta porque la API responde 200 en recuperación de contraseña
# incluso si el envío falla (respuestas genéricas por diseño, para no
# permitir enumerar cuentas): un 200 no confirma que el correo salió.
#
# Gmail/Google Workspace: SMTP_PASS debe ser una contraseña de aplicación
# (16 letras minúsculas seguidas, sin espacios) de
# https://myaccount.google.com/apppasswords, no la contraseña de la
# cuenta; con esta última el servidor responde 534-5.7.9. Además Gmail
# reescribe el remitente a la cuenta autenticada salvo alias verificado,
# así que SMTP_FROM debería coincidir con SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alcaldia@munipalmares.go.cr

# ============================================================
# Retención de la bitácora de auditoría
# ============================================================
# Meses que se conservan en bitacora_logs. BitacoraLimpiezaService borra
# cada mes (día 1 a las 03:00) lo anterior a esa ventana. El acuerdo del
# proyecto son 3 meses, que es también el valor por defecto si esta
# variable no existe o trae un valor inválido.
#
# ATENCION: el borrado es FISICO y no hay respaldo previo. Si la
# institución necesita conservar el histórico más allá de la ventana de
# consulta en línea (ISO 27001 A.12.4 / CGR), hay que exportar el tramo
# antes de purgarlo; está pendiente de decisión del equipo.
# Poner 0 deshabilita la purga: la tabla volvería a crecer sin límite.
BITACORA_RETENCION_MESES=3
